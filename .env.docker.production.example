APP_NAME=MapR
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mapr.example.com
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=mapr
DB_USERNAME=mapr
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
MAPBOX_ACCESS_TOKEN=
# Set only actual REMOTE_ADDR proxy IPs/CIDRs after checking the Docker network.
TRUSTED_PROXIES=
MAPR_HTTP_PORT=8000
